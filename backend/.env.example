# Server
PORT=4000
NODE_ENV=development

# MongoDB
# Use your own MongoDB Atlas/local connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>
MONGODB_DB_NAME=foreverbuy

# JWT
# Generate a long random value for production.
JWT_SECRET=replace_with_a_long_random_secret

# CORS
# These must match the URLs where your frontend and admin apps run.
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Cloudinary
# Required for product image upload/storage.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_api_secret

# Admin login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password

# App settings
DELIVERY_FEE=10

# AI Assistant
# Optional. If empty, the assistant still handles FAQs/search/recommendations using local logic.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview
